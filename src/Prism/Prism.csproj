<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Enable trim/AOT analyzers on the modern target; net48 and
         netstandard2.0 cannot run these analyzers. -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <PackageId>Prism.Net</PackageId>
    <Version>0.18.3</Version>
    <Authors>Prism Contributors</Authors>
    <Company>Prism</Company>
    <Product>Prism.Net</Product>
    <Description>.NET binding for Prism - Platform-agnostic Reader Interface for Speech and Messages</Description>
    <Copyright>Copyright 2024 Prism Contributors</Copyright>
    <License>MPL-2.0</License>
    <RepositoryUrl>https://github.com/qt06/prism.net</RepositoryUrl>
    <ProjectUrl>https://github.com/qt06/prism.net</ProjectUrl>
    <PackageProjectUrl>https://github.com/qt06/prism.net</PackageProjectUrl>
    <RootNamespace>Prism</RootNamespace>
    <AssemblyName>Prism.Net</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prism.Tests" />
  </ItemGroup>

</Project>